note = "Funding Information: Acknowledgements The authors acknowledge support from the Idaho Space Grant Consortium, Idaho NASA EPSCoR, the University of Idaho, the University of Idaho College of Engineering, the University of Idaho College of Science, and California Institute of Technology Jet Propulsion Laboratory.",
year = "2012",
